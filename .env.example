# Qloo — mock works with no key. Live key only talks to the hackathon host.
# Keep QLOO_API_KEY on the server. Never prefix it with NEXT_PUBLIC_.
# Never paste the key into the repo, the page, or client JS.
QLOO_MODE=mock
QLOO_API_KEY=
# Informational only. The live client is locked to https://hackathon.api.qloo.com.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# OpenRouter — optional. Without a key the agent writes deterministic briefs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Working title. Change here or in lib/config.ts (APP_NAME).
NEXT_PUBLIC_APP_NAME=Advance

# Shared store (needed on Vercel). Leave CONVEX_URL empty to use the local
# file store under .data/. Server-side only: never NEXT_PUBLIC_*.
CONVEX_URL=
# Same value on Vercel and on Convex (npx convex env --prod set ADVANCE_STORE_SECRET).
ADVANCE_STORE_SECRET=
# Written by `npx convex dev`; used by the Convex CLI, not the app.
CONVEX_DEPLOYMENT=
